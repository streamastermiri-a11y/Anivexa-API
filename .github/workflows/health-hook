# Keeps the /health hook in index.js after "Sync fork".
#
# index.js belongs to upstream, so a sync (or a merge conflict resolved in
# upstream's favour) can drop the hook and /health/status stops working.
# This workflow runs on every push to the default branch, puts the hook back
# if it is missing, and commits that change. If the hook is already there it
# does nothing. You can also run it by hand: Actions tab -> "Keep /health hook"
# -> Run workflow. See health/README.md.

name: Keep /health hook

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  restore-hook:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Put the hook back if it is missing
        run: node health/install-hook.js

      - name: Commit the change (only if index.js changed)
        env:
          ACTOR: ${{ github.actor }}
          ACTOR_ID: ${{ github.actor_id }}
        run: |
          if git diff --quiet -- index.js; then
            echo "Hook already in place - nothing to commit."
            exit 0
          fi
          git config user.name "$ACTOR"
          git config user.email "${ACTOR_ID}+${ACTOR}@users.noreply.github.com"
          git add index.js
          git commit -m "Restore /health hook in index.js (automatic, after sync)"
          git push origin HEAD
